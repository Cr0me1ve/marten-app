<?xml version="1.0" encoding="UTF-8"?>
<!--
  Marten AppStream Metadata
  Place this file at: linux/packaging/myappid.appdata.xml
-->
<component type="desktop-application">
  <id>app.marten.client</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Marten</name>
  <summary>Modern network profile manager for Linux</summary>

  <developer_name>Marten</developer_name>
  <update_contact>programmermr0@gmail.com</update_contact>

  <description>
    <p>
      Marten is an advanced network profile client built for privacy and control.
      It supports multiple backend protocols including V2Ray, Xray, Clash, and Sing-box,
      providing flexibility and performance for user-provided configurations.
    </p>
    <p>
      Designed with simplicity in mind, Marten helps users connect securely and
      manage complex network configurations through a clean graphical interface.
    </p>
  </description>

  <launchable type="desktop-id">marten.desktop</launchable>

  <icon type="stock">marten</icon>

  <categories>
    <category>Network</category>
  </categories>

  <keywords>
    <keyword>Marten</keyword>
    <keyword>V2Ray</keyword>
    <keyword>Nekoray</keyword>
    <keyword>Xray</keyword>
    <keyword>Sing-box</keyword>
  </keywords>

  <mime-types>
    <mime-type>x-scheme-handler/marten</mime-type>
    <mime-type>x-scheme-handler/v2ray</mime-type>
    <mime-type>x-scheme-handler/v2rayn</mime-type>
    <mime-type>x-scheme-handler/v2rayng</mime-type>
    <mime-type>x-scheme-handler/clash</mime-type>
    <mime-type>x-scheme-handler/clashmeta</mime-type>
    <mime-type>x-scheme-handler/sing-box</mime-type>
  </mime-types>

  <url type="homepage">https://github.com/Cr0me1ve/marten-client</url>
  <url type="bugtracker">https://github.com/Cr0me1ve/marten-client/issues</url>
  <url type="help">https://github.com/Cr0me1ve/marten-client</url>

  <provides>
    <binary>marten</binary>
  </provides>

  <releases>
    <release version="1.0.0" date="2025-10-25">
      <description>
        <p>Initial Linux release of Marten with multi-protocol support and modern UI.</p>
      </description>
    </release>
  </releases>

  <translation type="gettext">marten</translation>

  <custom>
    <value key="PackageName">marten</value>
    <value key="Priority">optional</value>
    <value key="Section">x11</value>
    <value key="InstalledSize">6604</value>
    <value key="Essential">false</value>
  </custom>
</component>
